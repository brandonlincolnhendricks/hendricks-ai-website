# Public site configuration
NEXT_PUBLIC_SITE_URL=https://hendricks.ai
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_VERCEL_ENV=development

# Optional measurement — leave empty to keep tags unloaded.
# Both still require analytics consent via Privacy Choices.
# Set these in Vercel only when a real ID exists. Do not invent values.
# NEXT_PUBLIC_GA_MEASUREMENT_ID: GA4 web stream (format G-XXXXXXXX).
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID: LinkedIn Insight partner ID (digits).
# Do not set the LinkedIn ID in production until the Privacy Notice names it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Sanity — required from Phase 6
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-01
SANITY_READ_TOKEN=
SANITY_PREVIEW_SECRET=
SANITY_REVALIDATE_SECRET=

# Lead delivery for the three inquiry forms. All three are required together.
# With any one of them missing, and no CRM webhook configured, the server action
# fails closed: it returns the delivery error and never reports a success it
# could not deliver (decision D-H). The names of the missing variables are
# written to the server log; no value is ever printed.
# LEAD_NOTIFICATION_EMAIL is the monitored inbox, brandon@hendricks.ai.
RESEND_API_KEY=
LEAD_FROM_EMAIL=Hendricks Website <website@hendricks.ai>
LEAD_NOTIFICATION_EMAIL=

# Optional CRM webhook. A second durable destination for the same submission.
# When the secret is set the body is signed as x-hendricks-signature, an
# HMAC-SHA256 hex digest of the JSON payload.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Optional spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared store for the rate limit and the idempotency bucket.
# Required for either to hold across serverless instances (15 blocker 3).
# RATE_LIMIT_REDIS_URL is the Upstash Redis REST endpoint, not a redis:// URL.
# RATE_LIMIT_HASH_SECRET must be at least 32 characters and is rotated
# quarterly; rotating it expires every key in the store, which is the intended
# way to clear the table.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
RATE_LIMIT_HASH_SECRET=

# Public-mini /observe queue (PR2 bridge). Redis is optional and not required
# to build or merge. RATE_LIMIT_REDIS_* above is reused when both are set.
# Those values are not on Vercel today. Production Redis needs Brandon-approved
# env. Do not put DataForSEO or Ultra probe credentials in this app.
# OBSERVE_JOB_STORE: memory (default) | fs | redis
# OBSERVE_IP_RATE_LIMIT: creates per hashed IP per hour. Default 3. Raise
# only for local Playwright. Do not raise in production.
# OBSERVE_FIXTURE: 1 loads a labeled non-production filled fixture. Never set
# this in production. Default boards stay pending or unmeasured.
# OBSERVE_WORKER_SECRET: bearer token for POST /api/observe/jobs/:job_id/cells
# The Next app reads it to authorize Ultra writes. The off-box worker
# (pnpm observe:worker) sends it. Do not put DataForSEO keys here.
# Live probes read DATAFORSEO_LOGIN and DATAFORSEO_PASSWORD from the Ultra
# environment only, never from this app.
OBSERVE_JOB_STORE=
OBSERVE_FIXTURE=0
OBSERVE_WORKER_SECRET=
OBSERVE_COST_CEILING_USD=2

# DEVIATION FROM THE LINE ABOVE, RECORDED RATHER THAN SILENT. The /observe
# block says live probe credentials never come from this app. The two
# DataForSEO variables below are exactly that, because the off-box worker that
# keeps them out is a manual Ultra script that is not armed and is documented
# "do not run against production". Brandon rules which of the two stands; see
# the long note on the same variables in src/lib/env/index.ts.
# The CRM for now is a Google Sheet (Brandon, 2026-09-07). The website appends a
# row per lead form submission (tab "Leads") and per AI Visibility Check (tab
# "Visibility Checks") as the service account below, which has no project role:
# its only access is the writer share on the sheet. The private key is the PEM
# from the key file, base64 encoded. All three are required together; with any
# one missing the channel is skipped and the omission is logged.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
CRM_SHEET_ID=

# The AI Visibility Check on / and /ai-visibility-check runs twenty live probes
# through DataForSEO: the same four endpoints and the same parser The Answer
# Index was captured through. Roughly 70 cents per run at 2026-09 list prices,
# almost all of it the ChatGPT endpoint. Without credentials the form renders
# and every submission returns the unavailable state.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Spend ceilings for the free check. The daily cap is the most runs the site
# will pay for in one UTC day; the per-visitor limit is fixed in code.
VISIBILITY_CHECK_DAILY_CAP=40

# Whether the visitor gets their own copy of the reading by email. Off until an
# applicant-facing message is approved (DR-95); the reading shows on screen.
VISIBILITY_CHECK_SEND_VISITOR_COPY=false
